# PostgreSQL connection string
# Local Docker (see docker-compose.yml at repo root): postgresql://aiexplorers:aiexplorers@localhost:5432/ai_explorers
# Or use a free hosted Postgres (Neon, Supabase, Railway) and paste its connection string here.
DATABASE_URL="postgresql://aiexplorers:aiexplorers@localhost:5432/ai_explorers"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4100
CLIENT_ORIGIN="http://localhost:5273"
NODE_ENV="development"

# AI provider: "anthropic", "openai", or "gemini" - powers the in-lesson AI Tutor chat
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Seed admin account (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@aiexplorers.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
