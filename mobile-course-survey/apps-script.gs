const SPREADSHEET_ID = '1_bTvTExdAyWi45wJ9QKHY1RS5euLGYGKlwaoaSAuUmw';
const SHEET_NAME = 'תשובות';
const HEADERS = ['חותמת זמן','אופן הזדהות','שם (אופציונלי)','טלפון (אופציונלי)','מחזור קורס','Q1','Q2','Q3','Q4','Q5','Q6','Q7','Q8','Q9','Q10','Q11','Q13 – NPS','Q14','Q15 – מה היה הכי מועיל?','Q16 – מה כדאי לשפר?','Q17 – נושאים לקורסים הבאים'];
function doGet(){return ContentService.createTextOutput(JSON.stringify({ok:true,service:'ICD snoring survey'})).setMimeType(ContentService.MimeType.JSON)}
function doPost(e){try{const p=JSON.parse(e.postData.contents||'{}');const sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);if(!sh)throw new Error('Missing sheet');if(sh.getLastRow()===0)sh.appendRow(HEADERS);sh.appendRow([p.timestamp||new Date().toISOString(),p.identity||'אנונימי',p.name||'',p.phone||'',p.cohort||'',p.Q1||'',p.Q2||'',p.Q3||'',p.Q4||'',p.Q5||'',p.Q6||'',p.Q7||'',p.Q8||'',p.Q9||'',p.Q10||'',p.Q11||'',p.Q13||'',p.Q14||'',p.Q15||'',p.Q16||'',p.Q17||'']);return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON)}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err)})).setMimeType(ContentService.MimeType.JSON)}}
